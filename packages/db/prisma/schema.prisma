generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanningStatusSource {
  NONE
  GITHUB_LABEL
  GITHUB_PROJECT
  LOCAL
}

enum GitHubProjectItemContentType {
  ISSUE
  DRAFT_ISSUE
}

model GitHubRepository {
  id                   String                    @id @default(cuid())
  githubId             String                    @unique
  nodeId               String                    @unique
  owner                String
  name                 String
  fullName             String                    @unique
  url                  String
  visibility           String
  isPrivate            Boolean
  isFork               Boolean
  isArchived           Boolean
  defaultBranch        String?
  primaryLanguageName  String?
  primaryLanguageColor String?
  pushedAt             DateTime?
  githubUpdatedAt      DateTime?
  hasLinkedProject     Boolean
  linkedProjectCount   Int
  hasIssuesCreated     Boolean
  issueCount           Int
  openIssueCount       Int
  pullRequestCount     Int                       @default(0)
  openPullRequestCount Int                       @default(0)
  pullRequestsSyncedAt DateTime?
  favorite             Boolean                   @default(false)
  favoriteOrder        Int?
  syncedAt             DateTime
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  issues               GitHubIssue[]
  pullRequests         GitHubPullRequest[]
  projects             GitHubRepositoryProject[]

  @@index([fullName])
  @@index([favorite, fullName])
  @@index([favorite, favoriteOrder, fullName])
  @@index([owner])
  @@index([syncedAt])
}

model GitHubPullRequest {
  id           String           @id @default(cuid())
  githubId     String
  nodeId       String
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  state        String
  url          String
  authorLogin  String?
  isDraft      Boolean
  commentCount Int
  createdAt    DateTime
  updatedAt    DateTime
  syncedAt     DateTime

  @@unique([repositoryId, number])
  @@unique([repositoryId, githubId])
  @@unique([nodeId])
  @@index([repositoryId, state, updatedAt])
  @@index([repositoryId, updatedAt])
  @@index([syncedAt])
}

model GitHubIssue {
  id                      String               @id @default(cuid())
  githubId                String
  nodeId                  String
  repositoryId            String
  repository              GitHubRepository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  number                  Int
  title                   String
  bodyText                String               @default("")
  state                   String
  url                     String
  authorLogin             String?
  labels                  String[]
  assignees               String[]
  commentCount            Int
  createdAt               DateTime
  updatedAt               DateTime
  closedAt                DateTime?
  syncedAt                DateTime
  planningStatus          String?
  planningStatusSource    PlanningStatusSource @default(NONE)
  planningStatusUpdatedAt DateTime?
  planningStartDate       DateTime?
  planningEndDate         DateTime?
  projectItems            GitHubProjectItem[]

  @@unique([repositoryId, number])
  @@unique([repositoryId, githubId])
  @@unique([nodeId])
  @@index([repositoryId, planningStatus, updatedAt])
  @@index([repositoryId, state, updatedAt])
  @@index([repositoryId, number])
  @@index([syncedAt])
}

model GitHubProject {
  id                String                    @id @default(cuid())
  nodeId            String                    @unique
  title             String
  owner             String
  url               String
  statusFieldNodeId String?
  statusOptions     Json?
  importedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  repositories      GitHubRepositoryProject[]
  items             GitHubProjectItem[]

  @@index([owner, title])
  @@index([importedAt])
}

model GitHubRepositoryProject {
  id           String           @id @default(cuid())
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  projectId    String
  project      GitHubProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importedAt   DateTime

  @@unique([repositoryId, projectId])
  @@index([projectId])
}

model GitHubProjectItem {
  id                   String                       @id @default(cuid())
  nodeId               String                       @unique
  projectId            String
  project              GitHubProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueId              String?
  issue                GitHubIssue?                 @relation(fields: [issueId], references: [id], onDelete: Cascade)
  contentType          GitHubProjectItemContentType @default(ISSUE)
  draftTitle           String?
  draftBodyText        String?
  draftAuthorLogin     String?
  draftAssignees       String[]                     @default([])
  draftCreatedAt       DateTime?
  draftUpdatedAt       DateTime?
  importedStatusName   String?
  importedStatusOption String?
  importedAt           DateTime
  itemUpdatedAt        DateTime?

  @@unique([projectId, issueId])
  @@index([issueId])
  @@index([projectId, importedAt])
}

model GitHubRepositorySyncRun {
  id              String    @id @default(cuid())
  status          String
  repositoryCount Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}
