generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanningStatus {
  NO_STATUS
  BACKLOG
  READY
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum PlanningStatusSource {
  NONE
  GITHUB_LABEL
  GITHUB_PROJECT
  LOCAL
}

model GitHubRepository {
  id                 String   @id @default(cuid())
  githubId           String   @unique
  nodeId             String   @unique
  owner              String
  name               String
  fullName           String   @unique
  url                String
  visibility         String
  isPrivate          Boolean
  isFork             Boolean
  isArchived         Boolean
  defaultBranch      String?
  pushedAt           DateTime?
  githubUpdatedAt    DateTime?
  hasLinkedProject   Boolean
  linkedProjectCount Int
  hasIssuesCreated   Boolean
  issueCount         Int
  openIssueCount     Int
  favorite           Boolean  @default(false)
  syncedAt           DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  issues             GitHubIssue[]
  projects           GitHubRepositoryProject[]

  @@index([fullName])
  @@index([favorite, fullName])
  @@index([owner])
  @@index([syncedAt])
}

model GitHubIssue {
  id           String           @id @default(cuid())
  githubId     String
  nodeId       String
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  state        String
  url          String
  authorLogin  String?
  labels       String[]
  assignees    String[]
  commentCount Int
  createdAt    DateTime
  updatedAt    DateTime
  closedAt     DateTime?
  syncedAt     DateTime
  planningStatus          PlanningStatus       @default(NO_STATUS)
  planningStatusSource    PlanningStatusSource @default(NONE)
  planningStatusUpdatedAt DateTime?
  projectItems            GitHubProjectItem[]

  @@unique([repositoryId, number])
  @@unique([repositoryId, githubId])
  @@unique([nodeId])
  @@index([repositoryId, planningStatus, updatedAt])
  @@index([repositoryId, state, updatedAt])
  @@index([repositoryId, number])
  @@index([syncedAt])
}

model GitHubProject {
  id             String   @id @default(cuid())
  nodeId         String   @unique
  title          String
  owner          String
  url            String
  importedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  repositories   GitHubRepositoryProject[]
  items          GitHubProjectItem[]

  @@index([owner, title])
  @@index([importedAt])
}

model GitHubRepositoryProject {
  id           String           @id @default(cuid())
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  projectId    String
  project      GitHubProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importedAt   DateTime

  @@unique([repositoryId, projectId])
  @@index([projectId])
}

model GitHubProjectItem {
  id                   String        @id @default(cuid())
  nodeId               String        @unique
  projectId            String
  project              GitHubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueId              String
  issue                GitHubIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  importedStatusName   String?
  importedStatusOption String?
  importedAt           DateTime
  itemUpdatedAt        DateTime?

  @@unique([projectId, issueId])
  @@index([issueId])
  @@index([projectId, importedAt])
}

model GitHubRepositorySyncRun {
  id              String    @id @default(cuid())
  status          String
  repositoryCount Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}
